{
  "name": "daily-discovery-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Daily Discovery: Production-Ready Daily Discovery + News Platform",
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "powershell -Command \"& apps/api/venv/Scripts/uvicorn app.main:app --app-dir apps/api --reload --port 8000\"",
    "build:web": "npm --prefix apps/web run build",
    "test:api": "powershell -Command \"& apps/api/venv/Scripts/pytest apps/api/tests -v\"",
    "seed": "powershell -Command \"& apps/api/venv/Scripts/python database/seed_data.py\""
  }
}
