{
  "name": "daily-discovery-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Daily Discovery: Production-Ready Daily Discovery + News Platform",
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "node scripts/run.js uvicorn app.main:app --app-dir apps/api --reload --port 8000",
    "build:web": "npm --prefix apps/web run build",
    "test:api": "node scripts/run.js pytest apps/api/tests -v",
    "seed": "node scripts/run.js python database/seed_data.py"
  }
}
