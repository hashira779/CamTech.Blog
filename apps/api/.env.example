# ==============================================================================
# Template for the two files this project needs on a server, and never commits:
#
#   apps/api/.env                     - a developer's laptop, run directly by uvicorn/pytest
#   <repo root>/.env                  - read by `docker compose` for ${VAR} substitution
#
# Copy this to whichever one you are setting up and replace every <placeholder>.
# Generate a signing key with:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Never put a real value in a file that git can see, and never paste one into a chat, a ticket
# or a screenshot. Anything already committed has to be rotated, not deleted: the history keeps
# the old value whether or not the file is tracked any more.
#
# Existing admin sessions are signed with the old key, so changing it logs everyone out. That is
# the intended behaviour when the previous key might have been read.
# ==============================================================================

APP_NAME=<Daily Discovery>
# production on a server, development on a laptop. `docker-compose.yml` already forces
# APP_ENV=production for the api and worker containers, so the server file does not need it.
APP_ENV=<production>
PORT=<8000>
DEBUG=<false>
FRONTEND_URL=<https://blog.camtech.cam>

# Signs every admin session. Must not be empty, and must not be a value that ever lived in this
# repository - the app refuses to boot on either, rather than running on a key the world knows.
JWT_SECRET=<generate a fresh token>
SESSION_SECRET=<generate a fresh token>
ACCESS_TOKEN_EXPIRE_MINUTES=<1440>

# Only read by database/seed_data.py, which creates the first administrator when both are set and
# otherwise skips user creation. Delete these two lines once the account exists; further editors
# are made in Admin, where the password never lands in a file.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# SQLite locally, Postgres on the server. The password belongs to the server file only.
DATABASE_URL=<postgresql+psycopg2://discovery_user:PASSWORD@postgres:5432/daily_discovery>
REDIS_URL=<redis://:PASSWORD@redis:6379/0>

# AI generation. Providers and keys are managed in Admin -> Settings -> AI Providers (stored in
# the database and masked on read); this is only the fallback for a brand-new install.
AI_PROVIDER=<local>
AI_API_KEY=

STORAGE_PROVIDER=<local>
STORAGE_LOCAL_DIR=<./uploads>
STORAGE_BUCKET=<daily-discovery-media>
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

ADSENSE_PUBLISHER_ID=<ca-pub-0000000000000000>
ADSENSE_ENABLED=<false>
