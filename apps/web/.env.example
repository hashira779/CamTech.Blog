# Front-end build configuration for CamTech.Blog (apps/web).
#
# Copy to .env.local for development. Everything here is PUBLIC: NEXT_PUBLIC_* values are inlined
# into the JavaScript the browser downloads, so never put a secret in one.
#
# These are BUILD-time values. On the server they are supplied as docker build args (see
# docker-compose.yml); editing them in a running container changes nothing until the web image is
# rebuilt.

# Where the site believes it lives. Drives canonical URLs, metadataBase, sitemap and og:image, so it
# must be the exact origin readers and Google actually reach.
NEXT_PUBLIC_SITE_URL="https://blog.camtech.cam"

# Browser-side API origin. The public proxy path, not the container's internal one.
NEXT_PUBLIC_API_URL="https://cms.camtech.cam/api/v1"

# ---------------------------------------------------------------------------
# Google AdSense  (docs/monetization.md has the dashboard steps)
# ---------------------------------------------------------------------------

# Your publisher account, shown in AdSense as ca-pub- followed by 16 digits.
# Leave it as the all-zeros sample (or empty) during development: nothing ad-related is then
# requested or rendered, which also keeps you from accidentally clicking your own live ads - the
# single fastest way to get an account suspended.
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID="ca-pub-0000000000000000"

# "false" switches ads off for the build even when a real account is set.
NEXT_PUBLIC_ADSENSE_ENABLED="false"

# One entry per placement: PLACEMENT=numericAdUnitId, taken from AdSense → Ads → By ad unit.
# A placement that is not listed renders nothing (no empty box, no invalid request).
# Valid placements:
#   HOME_TOP HOME_MID ARTICLE_TOP ARTICLE_MID ARTICLE_BOTTOM
#   SIDEBAR DISCOVERY_MID TOOL_BOTTOM GUIDE_BOTTOM TRENDING_MID
NEXT_PUBLIC_ADSENSE_SLOTS=""

# Optional AdSense channel label, so reporting can be split per site section.
NEXT_PUBLIC_ADSENSE_CHANNEL=""
