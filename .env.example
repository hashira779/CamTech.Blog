# Daily Discovery Environment Configuration

# Application
APP_NAME=Daily Discovery
APP_ENV=development
PORT=8000
DEBUG=True
FRONTEND_URL=http://localhost:3000

# Database (Default local SQLite for instant setup; switch to PostgreSQL for production)
# PostgreSQL example: postgresql://postgres:password@localhost:5432/daily_discovery
DATABASE_URL=sqlite:///./daily_discovery.db

# Redis Caching (Optional; in-memory fallback included)
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
JWT_SECRET=daily_discovery_dev_jwt_secret_key_2026_growth_platform
SESSION_SECRET=daily_discovery_session_secret_2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Abstraction (options: local, openai, anthropic, gemini)
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

# Media & Storage Provider (options: local, s3, r2, gcs)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_BUCKET=daily-discovery-media
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Google OAuth & Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# Analytics & Ads
ANALYTICS_ID=DD-ANALYTICS-DEV
ADSENSE_PUBLISHER_ID=ca-pub-0000000000000000
ADSENSE_ENABLED=false
